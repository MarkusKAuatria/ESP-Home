# Kopiere diese Datei nach "secrets.yaml" und trage deine eigenen Werte ein.
# secrets.yaml wird durch .gitignore nicht ins Repository übernommen.

wifi_ssid: "MeinWLAN"
wifi_password: "MeinWLANPasswort"

# 32 Byte, Base64-kodiert – neu erzeugen z. B. mit:  openssl rand -base64 32
# Wird für die API und für OTA-Updates verwendet.
api_encryption: "ERSETZEN-durch-openssl-rand-base64-32="

# Fallback-Hotspot (mindestens 8 Zeichen)
fallback_ap_password: "fallback123"
